/* 登录弹窗：全屏遮罩 + 居中卡片（替代原内联卡片） */
.lp-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: lp-fade 0.18s ease-out;
}
.lp-card {
  width: 84%;
  max-width: 640rpx;
  background: #fff;
  border-radius: var(--radius, 24rpx);
  padding: 48rpx 36rpx 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.25);
  animation: lp-pop 0.2s ease-out;
}
@keyframes lp-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes lp-pop {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
.lp-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: var(--text, #111827);
}
.lp-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-muted, #6b7280);
  text-align: center;
}
/* 微信原生风格按钮（微信绿） */
.lp-btn {
  margin: 36rpx 0 0;
  width: 100%;
  padding: 0;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  background: #07c160;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.28);
}
.lp-btn::after { border: none; }
.lp-btn.disabled { opacity: 0.6; }
.lp-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-muted, #6b7280);
  text-align: center;
}
.lp-close {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-muted, #6b7280);
  text-align: center;
  padding: 12rpx;
}
.lp-close:active { opacity: 0.6; }
