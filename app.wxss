/* ===== 设计变量 ===== */
page {
  --primary: #6366f1;          /* 靛蓝 */
  --primary-deep: #4f46e5;
  --primary-violet: #8b5cf6;   /* 紫罗兰 */
  --grad: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  --primary-soft: #ede9fe;     /* 淡紫底（标签/次按钮） */
  --primary-ink: #6d28d9;      /* 淡紫底上的文字色 */
  --bg: #f5f3ff;               /* 页面底：淡紫 */
  --card: #ffffff;
  --text: #0f172a;
  --text-sub: #64748b;
  --text-muted: #94a3b8;
  --line: #ece9f9;
  --danger: #f43f5e;
  --success: #10b981;
  --shadow: 0 2rpx 12rpx rgba(99, 102, 241, 0.08);
  --radius: 24rpx;
  background: var(--bg);
  font-family: -apple-system, "PingFang SC", sans-serif;
  color: var(--text);
  font-size: 30rpx;
}

.container {
  padding: 24rpx 24rpx 200rpx; /* 底部留出 tabBar + 安全区空间 */
}

/* ===== 卡片 ===== */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}
.card.tap { transition: transform 0.16s ease, background-color 0.16s ease; }
.card.tap:active { transform: scale(0.985); background: #f6f3ff; }
.title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 24rpx;
  color: var(--text);
}
.body { font-size: 30rpx; line-height: 1.7; color: var(--text); }
.muted { color: var(--text-muted); font-size: 24rpx; line-height: 1.6; }

/* 间距工具类：统一为 8rpx 的倍数 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }

/* ===== 按钮 ===== */
.btn {
  background: var(--grad);
  color: #fff;
  border-radius: 16rpx;
  padding: 26rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(99, 102, 241, 0.22);
  transition: transform 0.16s ease, opacity 0.16s ease;
}
.btn:active { transform: scale(0.97); opacity: 0.9; }
.btn.ghost {
  background: var(--primary-soft);
  color: var(--primary-ink);
  box-shadow: none;
}
.btn.disabled { opacity: 0.5; }
/* 文字按钮：用于低优先级操作（反馈、协议等） */
.btn.text {
  background: transparent;
  color: var(--text-muted);
  padding: 16rpx;
  font-size: 26rpx;
  font-weight: 400;
  box-shadow: none;
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  background: var(--primary-soft);
  color: var(--primary-ink);
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
}
.tag.warn { background: #ffe4e6; color: var(--danger); }
.tag.ok { background: #d1fae5; color: #047857; }
.hot-badge {
  display: inline-block;
  background: #ffe4e6;
  color: var(--danger);
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 10rpx;
}

/* ===== 输入 ===== */
input.input {
  background: #f6f5fd;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}
textarea.input {
  width: 100%;
  min-height: 220rpx;
  background: #f8f7fd;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.7;
}
.ph { color: var(--text-muted); }

/* ===== 类目撞色（多彩标识） ===== */
.c-writing { background: #eeecff; color: #4f46e5; }
.c-office { background: #e0f6fc; color: #0e7490; }
.c-doc { background: #fff1e6; color: #c2410c; }
.c-marketing { background: #ffe8f2; color: #be185d; }
.c-code { background: #e7edff; color: #1e40af; }
.c-study { background: #ecfccb; color: #3f6212; }
.c-design { background: #f3e8ff; color: #7e22ce; }
.c-translate { background: #ccfbf1; color: #0f766e; }
.c-life { background: #fef3c7; color: #b45309; }
.c-data { background: #ffe4e6; color: #9f1239; }
.c-other { background: #e4f8f0; color: #047857; }

/* 类目文字胶囊（用于分组标题） */
.cat-pill {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

/* ===== 渐变光斑装饰（Hero / 卡片） ===== */
.blob-host {
  position: relative;
  overflow: hidden;
}
.blob-host .blob-inner {
  position: relative;
  z-index: 1;
}
.blob-host::before,
.blob-host::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.blob-host::before {
  width: 280rpx;
  height: 280rpx;
  right: -90rpx;
  top: -110rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 70%);
}
.blob-host::after {
  width: 220rpx;
  height: 220rpx;
  right: 90rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
}

/* ===== 微动效 ===== */
.tappable {
  transition: transform 0.16s ease, background-color 0.16s ease;
}
.tappable:active { transform: scale(0.98); }

/* ===== 类目胶囊 ===== */
.cats {
  display: flex;
  flex-wrap: nowrap;
  white-space: nowrap;
  margin-top: 24rpx;
}
.cat {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #f1effb;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  transition: transform 0.16s ease;
}
.cat:active { transform: scale(0.94); }
.cat-on {
  background: var(--grad);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(99, 102, 241, 0.24);
}

/* ===== 空态 ===== */
.empty {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  border: 6rpx solid #e5e7eb;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  position: relative;
}
.empty-icon::before,
.empty-icon::after {
  content: "";
  position: absolute;
  left: 40rpx;
  top: 16rpx;
  width: 6rpx;
  height: 28rpx;
  background: #e5e7eb;
  border-radius: 3rpx;
}
.empty-icon::after { height: 20rpx; transform-origin: top; transform: rotate(35deg); }

/* ===== 骨架屏（加载态） ===== */
.skeleton {
  background: linear-gradient(90deg, #eef0f6 25%, #f6f7fb 37%, #eef0f6 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
  border-radius: 12rpx;
}
@keyframes skeleton {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
