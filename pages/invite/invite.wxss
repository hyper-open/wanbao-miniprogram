.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.btn-row .share { flex: 2; margin-top: 0; }
.btn-row .ghost { flex: 1; margin-top: 0; padding: 0; line-height: 88rpx; }
.link-line {
  margin-top: 16rpx;
  text-align: center;
}
.link-line .lnk { font-size: 24rpx; }
.hero {
  background: var(--grad);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.28);
}
.hero-title { font-size: 42rpx; font-weight: 700; }
.hero-sub { font-size: 25rpx; opacity: 0.9; margin-top: 12rpx; line-height: 1.6; }

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.code {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--primary-deep);
}
.copy {
  margin-top: 0;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}
.share {
  width: 100%;
  margin-top: 24rpx;
  padding: 0;
  line-height: 88rpx;
  font-size: 30rpx;
}
.rule { margin-top: 20rpx; line-height: 1.7; }

.stats { display: flex; }
.stat {
  flex: 1;
  text-align: center;
}
.stat .num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-deep);
  margin-bottom: 6rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
}

.rec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.rec-name { font-size: 30rpx; font-weight: 600; }
.rec-status { font-size: 24rpx; color: var(--text-muted); }
.rec-status.rewarded { color: var(--success); }
.rec-status.pending { color: #f59e0b; }
.rec-status.invalid,
.rec-status.capped,
.rec-status.expired { color: var(--text-muted); }
.rec-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.got { font-size: 26rpx; font-weight: 600; color: var(--primary-deep); }

.load-more { text-align: center; padding: 24rpx 0 8rpx; }

.bind-input {
  flex: 1;
  border: 1rpx solid #e3e6ee;
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

/* 离屏海报画布：移出可视区，仅用于生成分享图 */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1334px;
}
