/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  box-shadow: var(--shadow);
}
.search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--text-muted);
  border-radius: 50%;
  position: relative;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.search-icon::after {
  content: "";
  position: absolute;
  width: 4rpx;
  height: 14rpx;
  background: var(--text-muted);
  border-radius: 2rpx;
  transform: rotate(-45deg);
  right: -10rpx;
  bottom: -8rpx;
}
.search-input { flex: 1; font-size: 30rpx; }

/* 工具列表 */
.tool-list { margin-top: 24rpx; }
.tool-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.tool-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  font-size: 40rpx;
  line-height: 80rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.tool-main { flex: 1; min-width: 0; }
.tool-name { font-size: 32rpx; font-weight: 600; }
.tool-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tool-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.tool-price {
  font-size: 24rpx;
  color: var(--primary-ink);
  font-weight: 600;
  margin-left: 16rpx;
}
.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #d1d5db;
  border-right: 4rpx solid #d1d5db;
  transform: rotate(45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}
