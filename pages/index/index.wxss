/* Hero：靛蓝→紫罗兰渐变头部（含光斑装饰） */
.hero {
  background: var(--grad);
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(124, 58, 237, 0.28);
}
.hero-title { font-size: 46rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { font-size: 26rpx; opacity: 0.88; margin-top: 8rpx; }
.hero-quota {
  display: inline-block;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  font-size: 24rpx;
}

.section-head { display: flex; align-items: center; margin: 8rpx 4rpx 16rpx; }
.section-title { font-size: 34rpx; font-weight: 700; }

/* 热门工具：两列网格（一屏平铺 6 个，不横滑） */
.hot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.hot-card {
  box-sizing: border-box;
  width: calc((100% - 20rpx) / 2);
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow);
}
.hot-emoji {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
  line-height: 72rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.hot-name { font-size: 32rpx; font-weight: 600; }
.hot-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-top: 8rpx;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 76rpx;
}
.hot-price {
  font-size: 24rpx;
  color: var(--primary-ink);
  font-weight: 600;
  margin-top: 16rpx;
}

.group-head { margin: 24rpx 0 8rpx; }
.menu-btn { margin-top: 16rpx; }
.attach-tip { margin-top: 16rpx; }
.attach-name { margin-top: 16rpx; }

/* 区块右侧「全部 ›」 */
.section-more {
  font-size: 24rpx;
  color: var(--primary-deep, #4f46e5);
}
