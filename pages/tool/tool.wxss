.tag-item { margin-right: 20rpx; }

.attach-hint { font-size: 26rpx; }
.attach-name {
  font-size: 26rpx;
  color: var(--primary-deep);
  background: var(--primary-soft);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  word-break: break-all;
}

.foot { text-align: center; padding: 16rpx 0 40rpx; }

.retry-btn { width: 320rpx; margin: 24rpx auto 0; }

/* 骨架屏尺寸 */
.sk-title { width: 60%; height: 40rpx; margin-bottom: 24rpx; }
.sk-line { width: 100%; height: 28rpx; margin-bottom: 16rpx; }
.sk-line.short { width: 50%; }
.sk-box { width: 100%; height: 180rpx; margin-top: 16rpx; }

/* 底部固定操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
  z-index: 100;
}
.action-price { display: flex; align-items: baseline; }
.price-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-deep);
  line-height: 1;
}
.price-unit { font-size: 24rpx; color: var(--text-muted); margin-left: 6rpx; }
.action-btn {
  background: var(--grad);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 0;
  border-radius: 999rpx;
  min-width: 360rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(99, 102, 241, 0.24);
}
.action-btn:active { opacity: 0.85; }
.action-btn.disabled { opacity: 0.5; }
